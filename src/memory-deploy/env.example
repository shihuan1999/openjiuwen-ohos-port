# jiuwen_memory 设备端配置(/data/agents/memory/.env)
# 架构: sqlite(默认) + INDEX_BACKEND=file(markdown+FTS5+本地哈希向量) + rvcompute glm-5.2

# --- LLM(记忆抽取/反思用, OpenAI 兼容) ---
MODEL_PROVIDER=OpenAI
MODEL_NAME=glm-5.2
API_BASE=https://api.rvcompute.com:60000/v1
API_KEY=sk-YOUR_API_KEY
MODEL_SSL_VERIFY=false
TEMPERATURE=0.3

# --- embedding(占位,实际被 start_memory_server.py 的 LocalHashEmbedding 接管) ---
EMBED_MODEL_NAME=local-hash-384
EMBED_API_KEY=
EMBED_API_BASE=

# --- 存储后端 ---
INDEX_BACKEND=file
# local_sqlite = 启动器注入的 SqliteVectorStore(SQLite+numpy 余弦)
VECTOR_STORE_TYPE=local_sqlite
MEMORY_DATA_DIR=/data/agents/memory/data
FILE_MEMORY_DATA_DIR=/data/agents/memory/file_memory_data

# --- 服务 ---
IP=127.0.0.1
PORT=8000
